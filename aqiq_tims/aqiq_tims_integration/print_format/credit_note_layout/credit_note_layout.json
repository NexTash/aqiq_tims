{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2023-10-07 10:52:46.232315",
 "css": "td{\n    font-size:11px !important;\n}\n\n.watermark {\n    position: fixed;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(-45deg);\n    opacity: 0.5;\n    font-size: 100px;\n    color: rgba(255, 0, 0, 0.3);\n}\n@media print, pdf {\n    @page{\n        margin-top:-10px !important;\n    }\n      .main-table{\n            margin-left:5px !important;\n            height:85Vh;\n            width:100vw;\n            /*padding:0;*/\n    \n}\n}\n\n.text-center {\n    text-align: center;\n  }",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "{% set header = frappe.db.get_value(\"Letter Head\", {\"is_default\": 1}, \"content\") %}\n{% set company_details = frappe.db.get_list('Company', filters={'name': doc.company}, fields=['company_name', 'phone_no', 'email', 'tax_id', 'company_logo', 'website']) %}\n\n{% set company_address_line1 = '' %}\n{% set company_city = '' %}\n{% set company_country = '' %}\n{% set company_state = '' %}\n{% set phone = '' %}\n{% set email = '' %}\n\n{% set company_address_name = frappe.db.get_value(\"Dynamic Link\", {\"link_doctype\": \"Company\", \"link_name\": doc.company}, \"parent\") %}\n\n{% if company_address_name %}\n    {% set address = frappe.db.get_value(\"Address\", company_address_name, [\"address_line1\", \"address_title\", \"city\", \"country\", \"state\", \"email_id\", \"phone\"], as_dict=1) %}\n        \n    {% set company_address_line1 = address.address_line1 %}\n    {% set company_city = address.city %}\n    {% set company_country = address.country %}\n    {% set company_state = address.state %}\n    {% set phone = address.phone %}\n    {% set email = address.email_id %}\n{% endif %}\n<center><h3>{{ doc.company | upper }}</h3></center>\n<div style=\"font-size: 12px;\">\n  <div style=\"display: flex;\">\n    <div style=\"text-align: left; margin-right: auto;\"><strong>Date:</strong> {{ frappe.utils.formatdate(doc.posting_date, 'dd/mm/yy') }}</div>\n    <div style=\"text-align:center; margin-left: -20px;\"><strong>Credit Note No.</strong> {{ doc.name }}</div>\n    <div style=\"text-align: right; margin-left: auto;\"><b>ORIGINAL</b></div>\n  </div>\n</div>\n\n<table style=\"border: 1px solid black; font-size:11px; line-height:0.8\" class = \"main-table\">\n     <tr>\n  <td colspan=\"6\" style=\"border: 1px solid; height:auto\">\n    <table style=\"border: 1px solid; width: 100%; font-size:10px;\">\n      <tr>\n        <td colspan='8'>\n         <strong> Customer Details:</strong>\n        </td>\n        {% set cust_address = frappe.db.get_value('Sales Order', doc.customer, 'customer_address') %}\n        {% set till_no = frappe.db.get_value('Customer', doc.customer, 'tax_id') %}\n        {% set sales_rep = frappe.db.get_value('Sales Team', filters={'parent': doc.customer}, fieldname='sales_person', as_dict=0) %}\n\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"><b>Name</b></td>\n        <td colspan='4' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid; font-weight:bold;\">{{ doc.customer_name| upper }}</td>\n        <td colspan='2' style=\"border: 1px solid;\">{{ doc.name }}</td>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Address</td></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ cust_address or 'Not Provided'}}</td>\n         <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"> Payment Terms:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ doc.payment_terms_template }}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">TIN No:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ till_no }}</td>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">City</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Price Basis</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Sales Rep:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ sales_rep }}</td>\n      </tr>\n     <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Country</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ doc.territory }}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Sales Tax Type</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ doc.tax_type }}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Sales tax state:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n      </tr>\n    </table>\n  <br>\n \n  \n\n    <table style=\"border: 1px solid; width: 100%; font-size:10px;\">\n      <tr>\n        <td colspan='8'>\n         <strong> Delivery Details:</strong>\n        </td>\n      </tr>\n      {% set delivery_note_name = frappe.db.get_value(\"Sales Invoice Item\", filters={'parent': doc.name}, fieldname='delivery_note') %}\n        {% if delivery_note_name %}\n            {% set delivery_note = frappe.get_doc('Delivery Note', delivery_note_name) %}\n            {% set Consignee = delivery_note.customer or '' %}\n            {% set cust_order = delivery_note.po_no %}\n            {% set shipping_address = delivery_note.shipping_address_name or '' %}\n            {% set charges = delivery_note.total_net_weight %}\n            {% set total_qty = delivery_note.total_qty %}\n            {% set driver_name = delivery_note.driver_name or ''%}\n            {% set Vehicle_no = delivery_note.vehicle_no or ''%}\n            {% set date = delivery_note.lr_date or '' %}\n            {% set territory = delivery_note.territory or '' %}\n            {% set transporter = delivery_note.transporter or '' %}\n        {% else %}\n        \n        {% endif %}\n        \n\n       \n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"><b>Consignee</b></td>\n        <td colspan='4' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid; font-weight:bold;\">{{ doc.customer_name }}</td>\n        <td colspan='' style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Cust Order# </td>\n        <td colspan='' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ cust_order or '' }}</td>\n        \n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Address</td></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ shipping_address or '' }}</td>\n         <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"> Loaded</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Date:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">City</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Total Nos</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ total_qty or '' }} {% for item in doc.items %} {{ item.uom }}{% endfor %}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Driver Name:</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ driver_name or '' }}</td>\n      </tr>\n     <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Country</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ territory or '' }}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">loose Qty:</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Vehicle</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ Vehicle_no or '' }}</td>\n      </tr>\n    </table>\n  <br>\n   <table style=\"border: 1px solid; width: 100%; font-size:11px;\">\n    \n      \n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Destination</td></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid; text-align:left;\">{{doc.territory or '' }}</td>\n         <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"> Delivery Code</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Container #</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Transport Mode</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Transporter</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ transporter or ''  }}</td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Final Destination</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ shipping_address or '' }}</td>\n      </tr>\n      {% set sales_order = frappe.db.get_value('Sales Invoice Item', {'parent':doc.return_against}, 'sales_order') %}\n     <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">A.W.B./B.L.#.</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Dated</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Sales Invoice #</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ doc.return_against }}</td>\n        \n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Despatch Date</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Despatch Time</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Port of Loading</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        \n      </tr>\n       \n    </table>\n    <br>\n    <table style=\"border: 1px solid; width: 100%; font-size:10px;\">\n    \n      \n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Freight</td></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">By Consignee</td>\n         <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Chg. Wt.(KGS)</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Freight Chgs.</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Misc. Chgs.</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Total</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n      </tr>\n     <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\"></td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Export Doc #</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Sales Order #</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\">{{ sales_order }}</td>\n        \n      </tr>\n      <tr>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Insurance</td>\n        <td colspan='2' style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Policy #</td>\n        <td  style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        <td style=\"border: 1px solid; border-right: none; border-bottom: 1px solid;\">Dated</td>\n        <td style=\"border: 1px solid; border-left: none; border-right: 1px solid; border-bottom: 1px solid;\"></td>\n        \n      </tr>\n    </table>\n  \n  \n\n    </td>\n  </tr>\n  <tr>\n            <td colspan=\"6\" style=\"border: 1px solid;\">\n      <table style=\"border: 1px solid; width: 100%;font-size:10px; line-height:1;\">\n        <tr>\n          <th style=\"border: 1px solid;\">Srl</th>\n          <th style=\"border: 1px solid;\">Description of Goods</th>\n          <th style=\"border: 1px solid; text-align: center;\">Quantity</th>\n          <th style=\"border: 1px solid; text-align: center;\">UOM</th>\n          <th style=\"border: 1px solid; text-align:right\">Rate({{ doc.currency }})</th>\n          <!--<th style=\"border: 1px solid;\">Basic Value (UGX)</th>-->\n          <!--<th style=\"border: 1px solid;\">Discount (UGX)</th>-->\n          <!--<th style=\"border: 1px solid;\">Tax/Charges (UGX)</th>-->\n          <th colspan='2' style=\"border: 1px solid; text-align:right\">Totals ({{ doc.currency }})</th>\n          \n        </tr>\n        {% for item in doc.items %}\n        <tr>\n            <td style=\"border: 1px solid;\">{{ loop.index }}</td>\n            <td style=\"border: 1px solid;\">{{ item.description }}</td>\n            <td style=\"border: 1px solid; text-align: center;\">{{ item.qty }}</td>\n            <td style=\"border: 1px solid;  text-align: center;\">{{ item.uom }}</td>\n            <td style=\"border: 1px solid; text-align:right\">{{ frappe.utils.fmt_money(item.rate) }}</td>\n            <!--<td style=\"border: 1px solid;\">{{ frappe.utils.fmt_money(item.net_amount/(1+item.total_tax_percentage/100)) }}</td>-->\n            <!--<td style=\"border: 1px solid;\">{{ frappe.utils.fmt_money((item.discount_amount) * item.qty)}}</td>-->\n            <!--<td style=\"border: 1px solid;\">{{ frappe.utils.fmt_money((item.total_tax_percentage/100) * item.net_amount) }}</td>-->\n            <td colspan='2' style=\"border: 1px solid; text-align:right\">{{ frappe.utils.fmt_money('{:.2f}'.format(item.amount)) }}</td>\n        </tr>\n          {% endfor %}\n          \n         <tr>\n       <td colspan=\"\" style=\"border-top: 1px solid;\"></td>\n        </tr>\n       \n        <tr>\n        <td colspan=\"4\"> <p class=\"text-left\" style=\"\">CU Serial No: {{ doc.cusn}}</p></td>\n        <td  colspan=\"2\" style=\"font-weight:bold; text-align:right\">Grand Total</td>\n        <td  style=\"text-align:right\">{{frappe.utils.fmt_money('{:.2f}'.format(doc.total)) }}</td>\n        </tr>\n        <tr style=\"line-height: 0.8;\">\n            <td colspan=\"4\"> <p class=\"text-left\" style=\"\">CU Invoice No:{{ doc.cuin}}</p></td>\n            <td colspan=\"2\" style=\"font-weight:bold; text-align:right\">Less Discount {{doc.additional_discount_percentage}}%</td>\n            <td style=\"text-align: right\">{{ frappe.utils.fmt_money(doc.discount_amount) }}</td>\n        </tr>\n        <tr style=\"line-height: 0.8;\">\n            <td></td>\n            <td colspan='3' rowspan = \"3\">\n                <div class=\"text-center\" style=\"padding: 0; width:30%;\">\n                <img src=\"{{doc.kra_qr_code}}\" alt=\"QR Code here\" width = \"100\" height =\"100\">\n            </div>\n            </td>\n            <td colspan=\"2\"  style=\"font-weight:bold; text-align:right\">Round Off</td>\n            <td style=\"text-align: right\">{{frappe.utils.fmt_money(\"{:.0f}\".format(doc.grand_total)) }}</td>\n        </tr>\n        <tr style=\"line-height: 0.8;\">\n            <td colspan='4'></td>\n            <td colspan=\"2\"  style=\"font-weight:bold; text-align:right; border-bottom: 1px solid black;\">Invoice Total</td>\n            <td style=\"text-align: right; border-bottom: 1px solid black; font-weight: bold;\">{{frappe.utils.fmt_money(\"{:.2f}\".format(doc.grand_total)) }}</td>\n        </tr>\n        <tr>\n            <td colspan='4'></td>\n            <td  colspan=\"2\"  style = \"font-weight:bold; text-align: right;\">Net Total</td>\n            <td style = \"font-weight:bold; text-align: right;\">{{frappe.utils.fmt_money(\"{:.2f}\".format(doc.net_total)) }}</td>\n        </tr>\n        <tr style=\"line-height: 0.8;\">\n            <td colspan='4'></td>\n            <td colspan=\"2\" style =\"font-weight:bold; border-bottom:1px solid black; text-align:right\">Tax Total</td>\n            <td style=\"text-align: right; font-weight:bold; border-bottom:1px solid black;\">{{ frappe.utils.fmt_money(\"{:.2f}\".format(doc.total_taxes_and_charges)) }}</td>\n        </tr>\n        <tr>\n             <td colspan=\"8\" style=\"border-top: 1px solid; border-top: none;\">\n                 <b>Amount in words: {{ doc.base_in_words }}</b>\n             </td>\n        </tr>\n      </table>\n        </td>\n        </tr>\n        \n        <tr>\n            <td colspan=\"6\" style=\"border-bottom:none; height:10px;\">\n                <b>Our Bank Details</b>\n        </tr>\n          {% set bank_account = frappe.db.get_value('Bank Account', {'is_default':1}, 'bank') %}\n          {% set account_name = frappe.db.get_value('Bank Account', {'is_default':1}, 'account_name') %}\n          {% set account_number = frappe.db.get_value('Bank Account', {'is_default':1}, 'bank_account_no') %}\n          {% set swift_code = frappe.db.get_value('Bank', bank_account, 'swift_number') %}\n          {% set iban = frappe.db.get_value('Bank Account', bank_account, 'iban') %}\n        <tr>\n        <td colspan='' style= \"width:40%\">\n           <b> Swift Code :</b> {{ swift_code }}<br><br>\n           <p>A/c No. : {{ account_number }}</p><br>\n           <p>A/c No. For USD: {{ '' }}</p>\n        </td>\n        </tr>\n        <tr>\n            {% set kra_pin = frappe.db.get_value('Company', doc.company, 'tax_id') %}\n            <td colspan='2' style=\"border-top:1px solid black;\">Our VAT No.</td>\n            <td style=\"border-top:1px solid black;\">{{ kra_pin }}</td>\n            <td style=\"border-left:1px solid black; border-top:1px solid;\">Our Trade License No.</td>\n            <td style=\" border-right:1px solid; border-top:1px solid;\">None</td>\n            <td colspan= '3' style='text-align:right;  border-top:1px solid;'><b>EZZI GROUP CO. LTD.</b>\n            <div style=\"text-align: right; width: 150px; height: 150px; margin-left: auto;; position:absolute;margin-top:-80px; margin-left:-80px;\">\n                <img src=\"/private/files/stamp.png\" style =\"\">\n            </div>\n            </td>\n        </tr>\n        <tr>\n            <td colspan = '2'>Our Income Tax Card No</td>\n            <td>None</td>\n            <td style=\"border-left:1px solid black; border-bottom:1px solid;\">Dated</td>\n            <td colspan=''  style=\"border-right:1px solid black; border-bottom:1px solid;\"></td>\n        </tr>\n        <tr>\n            <td colspan='2'>Our Income Tax File No.</td>\n            <td>None</td>\n            <td style=\"border-left:1px solid black; \">Our Industrial License No.</td>\n            <td style=\" border-right:1px solid; \">None</td>\n            <td colspan= '3' style='text-align:right;'><b></b></td>\n        </tr>\n        <tr>\n            <td colspan='2'>Area</td>\n            <td>None</td>\n            <td style=\"border-left:1px solid black; \">Dated</td>\n            <td style=\" border-right:1px solid; \">None\n            <div style =\"width:80px;height:100px;margin-top:-70px;margin-left:70px; position:absolute;\">\n                <img src=\"/files/sign-removebg-preview.png\" >\n            </div>\n            </td>\n            <td colspan= '3' style='text-align:right;'><b></b>Authorised Signatory</td>\n        </tr>\n    \n    \n</table>\n<div style='line-height:0.6'>\n<p style=\"text-align: center; font-size:8px;\">{{ company_address_line1 }} {{ phone }} {{ company_city  or '' }} {{ company_country or '' }}</p>\n\n<hr style=\"border-color: black;\">\n\n <div style=\"text-align: center; font-size:8px;line-height:0.6\">\n  <span>Phone No: {{ phone }}</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n  <span>Email: {{ email }}</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n  <span>Fax:</span>\n</div>\n   </div>\n   \n   {% if doc.docstatus == 0 %}\n    <div class=\"watermark\">\n        DRAFT\n    </div>\n    {% endif %}\n\n</html>\n\n",
